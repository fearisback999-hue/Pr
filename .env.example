# ─── Copy to .env and fill in. Everything is optional: with no keys set, the
#     engine runs fully offline on the mock feed + deterministic LLM fallback. ───

# Claude API (Part 4 psychology, Part 7 hooks/scripts). If unset, the LLM
# modules fall back to deterministic offline logic.
ANTHROPIC_API_KEY=
# Model + effort for enrichment. Defaults are sensible; override only if needed.
TT_LLM_MODEL=claude-opus-4-8
TT_LLM_EFFORT=high

# ─── Data feeds (Part 2). Implement the matching adapter's fetch() before these
#     do anything. Stack two velocity sources and cross-confirm triggers. ───
KALODATA_API_KEY=
ECHOTIK_API_KEY=
PIPIADS_API_KEY=
GOOGLE_TRENDS_API_KEY=

# ─── Sourcing / fulfillment (Part 6). ───
CJ_DROPSHIPPING_API_KEY=
ZENDROP_API_KEY=

# ─── Creative (Part 7). Verified July 2026 — reverify before trusting, vendor APIs
#     move fast. Two ways to generate for real; either is enough, `creative` dry-runs
#     (plans the batch, persists as 'briefed') until one is live. Generation ALWAYS
#     needs --confirm regardless of which path is set up. ───
HIGGSFIELD_API_KEY=          # this project's own gate/tracking var
HF_KEY=                      # SAME value — the official higgsfield-client SDK reads
                              # this exact name itself (or HF_API_KEY + HF_API_SECRET).
                              # `pip install higgsfield-client` too.
HIGGSFIELD_SOUL_ID=          # pre-trained persona you hold rights to — ONE per store
# Alternative to the two vars above: if you're running this engine from inside a
# Claude Code session with the Higgsfield MCP connected (hosted at
# https://mcp.higgsfield.ai/mcp, browser OAuth — NOT an API key), just ask the agent
# to generate the batch directly through its own connected tools. No .env needed
# for that path at all.

# ─── Feedback (Part 13) — your own true net margin. ───
DASHBOARDLY_API_KEY=

# ─── Engine config ───
TT_DB_PATH=tt_engine.db
# Which velocity feed to use for the daily pass: mock | kalodata | echotik
TT_PRIMARY_FEED=mock
# Minimum total score to surface a candidate (Part 3).
TT_SCORE_THRESHOLD=80
